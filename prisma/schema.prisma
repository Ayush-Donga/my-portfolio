generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Experience {
  id          String   @id @default(uuid())
  title       String
  company     String
  location    String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  description String[]
  createdAt   DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  techStack   String[]
  liveUrl     String?
  githubUrl   String?
  imageUrl    String?
  category    String?
  problem     String?
  role        String?
  outcome     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Skill {
  id       String @id @default(uuid())
  category String // Frontend, Backend, DevOps, etc.
  name     String
  icon     String?
  level    Int?
}

model Education {
  id          String   @id @default(uuid())
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime?
  location    String
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Resume {
  id              String   @id @default(uuid())
  internalName    String   // e.g., "Full Stack Lead - 2025"
  isActive        Boolean  @default(false)
  
  // Personal Details
  personalInfo    Json     // { fullName, professionalTitle, photo, email, phone, location, socials: [], ... }
  
  // Custom Sections & Standard Sections (Curated data for this specific resume)
  content         Json     // Array of sections: { type: 'experience'|'education'|'skills'|'projects'|'custom', heading: string, items: [] }
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Settings {
  id              String   @id @default(uuid())
  // Profile
  fullName        String   @default("Ayush Donga")
  professionalTitle String @default("Full Stack Developer")
  bio             String?
  avatarUrl       String?
  
  // Contact
  email           String   @default("ayush.donga@gmail.com")
  phone           String?
  location        String?
  
  // Socials
  githubUrl       String?
  linkedinUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  
  // SEO & Site Config
  websiteUrl      String?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String[] 
  
  updatedAt       DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  company     String
  quote       String
  avatar      String?  // Initials or URL
  linkedinUrl String?
  logoUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}
